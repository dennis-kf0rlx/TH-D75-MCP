[Unit]
Description=TH-D75 settings web UI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/d75settings
Environment=D75_SERIAL=/dev/thd75
Environment=D75_MONITOR_UNIT=d75mon
ExecStart=%h/venv-d75settings/bin/python %h/d75settings/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
