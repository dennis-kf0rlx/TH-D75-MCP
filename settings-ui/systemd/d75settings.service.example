[Unit]
Description=TH-D75 settings web UI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TH-D75-MCP/settings-ui
Environment=D75_SERIAL=/dev/thd75
Environment=D75_MONITOR_UNIT=d75mon
ExecStart=%h/TH-D75-MCP/.venv/bin/python %h/TH-D75-MCP/settings-ui/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
