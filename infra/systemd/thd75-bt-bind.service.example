[Unit]
Description=Bind TH-D75 Bluetooth SPP serial port
After=bluetooth.service
Wants=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# Replace both values before installing:
#   THD75_BT_MAC   = the radio's Bluetooth MAC (bluetoothctl devices)
#   THD75_BT_OWNER = the desktop user who runs d75mon / settings-ui
Environment=THD75_BT_MAC=AA:BB:CC:DD:EE:FF
Environment=THD75_BT_OWNER=youruser
ExecStart=/usr/local/sbin/thd75-bt-bind
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
