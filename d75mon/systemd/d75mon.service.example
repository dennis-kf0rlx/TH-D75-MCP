[Unit]
Description=TH-D75 monitor widget (d75mon)
# user-unit scope: no ordering against system targets (network/bluetooth are
# system units); the bind service runs at system scope and d75mon reconnects.

[Service]
Type=simple
WorkingDirectory=%h/thd75-web-console/d75mon
ExecStart=%h/thd75-web-console/.venv/bin/python %h/thd75-web-console/d75mon/backend/d75mon.py --config %h/thd75-web-console/d75mon/config.json
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
