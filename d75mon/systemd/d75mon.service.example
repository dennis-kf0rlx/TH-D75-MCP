[Unit]
Description=TH-D75 monitor widget (d75mon)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/thd75-web-console/d75mon
ExecStart=%h/thd75-web-console/.venv/bin/python %h/thd75-web-console/d75mon/backend/d75mon.py --config %h/thd75-web-console/d75mon/config.json
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
