[Unit]
Description=TH-D75 monitor widget (d75mon)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TH-D75-MCP/d75mon
ExecStart=%h/TH-D75-MCP/.venv/bin/python %h/TH-D75-MCP/d75mon/backend/d75mon.py --config %h/TH-D75-MCP/d75mon/config.json
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
