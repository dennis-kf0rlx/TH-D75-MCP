[Unit]
Description=TH-D75 monitor widget (d75mon v0)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/d75mon
ExecStart=%h/venv-d75mon/bin/python %h/d75mon/backend/d75mon.py --config %h/d75mon/config.json
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
